// Copy to ios/Flutter/Secrets.xcconfig (gitignored) and fill in.
// xcconfig treats "//" as a comment, so no URLs here.

// Google Maps SDK for iOS key (restrict it to the iOS bundle id).
MAPS_API_KEY = your-ios-maps-api-key

// URL scheme Firebase Auth uses for phone sign-in (reCAPTCHA fallback):
// the "Encoded App ID" from Firebase console > Project settings > your iOS app,
// e.g. app-1-123456789012-ios-abcdef0123456789.
FIREBASE_IOS_URL_SCHEME = app-1-000000000000-ios-0000000000000000
